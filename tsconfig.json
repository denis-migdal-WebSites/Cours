{
    "extends": "./build/WebpackFramework/files/tsconfig.json",

    "include": ["./src"],

    "compilerOptions": {

        "rootDir": ".",
        "outDir": "./build/TS",

        "paths": {
            "@Cours/*"    : ["./src/*"],
            
            "MWL@2026/*"     : ["./libs/MWL@2026/src/*"],
            "TPEngine@2026/*" : ["./libs/TPEngine@2026/src/*"],
            "WebSlides@2026/*": ["./libs/WebSlides@2026/src/*"],

            "@LISS/*"     : ["./libs/legacy/LISS/V3/*"],
            "@TPEngine/*" : [ "./libs/legacy/TPEngine/src/*" ],
            "@WebSlides/*": [ "./libs/legacy/WebSlides/src/*" ],
            "@sqlite/*"   : [ "./libs/sqlite/*" ],
        }
    }
}